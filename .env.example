# Not needed for npm start or npm run dev. Enter your Groq API key in the app.
# Only for signed/notarized release builds:
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# Optional exported Developer ID certificate; otherwise use your macOS Keychain.
CSC_LINK=
CSC_KEY_PASSWORD=
# Only for npm run upload; configure your own bucket and gcloud authentication.
GCS_BUCKET=
