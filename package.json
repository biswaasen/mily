{
  "name": "mily",
  "version": "1.0.24",
  "description": "Mily — voice typing with your own API key",
  "main": "main.js",
  "scripts": {
    "build:react": "node build.js",
    "build:fn": "mkdir -p native && swiftc -O -o native/fn-listener native/fn-listener.swift",
    "dev": "npm run build:fn && npm run build:react && node scripts/dev.js",
    "start": "npm run build:fn && npm run build:react && electron .",
    "build": "node -r dotenv/config scripts/package.js",
    "dist": "npm run build",
    "upload": "node scripts/upload-to-gcs.js",
    "publish": "npm run build && npm run upload",
    "typecheck": "tsc --noEmit",
    "build:unsigned": "node -r dotenv/config scripts/package.js --unsigned",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "iohook-macos": "^1.2.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.8.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.0",
    "esbuild-plugin-copy": "^2.1.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.mily.app",
    "productName": "mily",
    "protocols": [
      {
        "name": "mily",
        "schemes": [
          "mily"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/logo.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "scripts/entitlements.mac.plist",
      "entitlementsInherit": "scripts/entitlements.mac.inherit.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "files": [
      "main.js",
      "config/**/*",
      "ipc/**/*",
      "services/**/*",
      "store.js",
      "windows.js",
      "system-commands.js",
      "public/**/*",
      "dist/app.js",
      "dist/main.js",
      "app.html",
      "main.html",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!**/*.map"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "native/fn-listener",
        "to": "fn-listener"
      }
    ],
    "afterSign": "scripts/notarize.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biswaasen/milycore.git"
  },
  "bugs": {
    "url": "https://github.com/biswaasen/milycore/issues"
  },
  "homepage": "https://github.com/biswaasen/milycore#readme",
  "engines": {
    "node": ">=22.12.0"
  }
}
